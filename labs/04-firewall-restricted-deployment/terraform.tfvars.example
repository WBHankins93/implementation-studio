# Firewall-Restricted Deployment Configuration
# Copy this file to terraform.tfvars and configure

# ============================================================================
# Cloud Provider Selection
# ============================================================================
# Choose one: "gcp" or "aws"
cloud_provider = "gcp"  # Change to "aws" for AWS deployment

# ============================================================================
# Common Configuration (applies to all providers)
# ============================================================================

cluster_name = "implementation-studio-firewall"
region = "us-central1"  # Change to AWS region (e.g., "us-west-2") if using AWS

# Network configuration
public_subnet_cidr  = "10.0.1.0/24"
private_subnet_cidr = "10.0.2.0/24"
proxy_subnet_cidr   = "10.0.3.0/24"

# Cluster configuration
node_count     = 2
min_node_count = 1
max_node_count = 5

# Proxy configuration
proxy_port = 3128

# Firewall/Security Group configuration
enable_strict_egress = true

# Optional: Allow specific external endpoints (if not using proxy)
# allowed_external_endpoints = {
#   "docker-hub" = {
#     protocol    = "tcp"
#     ports       = ["443"]
#     cidr        = "0.0.0.0/0"
#     description = "Docker Hub registry"
#   }
# }

# ============================================================================
# GCP-Specific Configuration (only used when cloud_provider = "gcp")
# ============================================================================

# project_id = "your-gcp-project-id"
# machine_type = "e2-medium"
# proxy_machine_type = "e2-micro"
# allow_gcp_services = true  # Allow egress to GCP services (Private Google Access)
# enable_vpa = false  # Enable Vertical Pod Autoscaling

# ============================================================================
# AWS-Specific Configuration (only used when cloud_provider = "aws")
# ============================================================================

# region = "us-west-2"  # AWS region
# vpc_cidr = "10.0.0.0/16"
# availability_zones = ["us-west-2a", "us-west-2b"]
# instance_type = "t3.medium"
# proxy_instance_type = "t3.micro"

# ============================================================================
# Resource Labels/Tags (applies to all providers)
# ============================================================================

# resource_labels = {
#   environment = "learning"
#   managed-by  = "terraform"
#   lab         = "04-firewall-restricted"
# }
